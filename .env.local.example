# Copie ce fichier en .env.local et remplis avec tes vraies valeurs.
# Ne mets jamais de vraie clé dans ce fichier d'exemple : il est enregistré dans le dépôt.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique-ici

# Clé de service : uniquement côté serveur, pour le Studio (jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=ta-cle-de-service-ici

# Mot de passe du Studio : ouvrir une fois /studio?k=<cette valeur>
ADMIN_KEY=choisis-une-longue-chaine-aleatoire
